# Demo defaults — safe to commit, not real secrets (same scott/tiger demo credentials used
# throughout the main OmniGate repo's own testing). Change these before exposing this stack
# beyond your own machine, especially if you uncomment OMNIGATE_AUTH_* in docker-compose.yml.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

ORAPG_AUTH_USER=scott
ORAPG_AUTH_PASSWORD=tiger
